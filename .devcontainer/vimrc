" ── General ──────────────────────────────────────────────────────────
set nocompatible
set encoding=utf-8
set fileencoding=utf-8

" ── Editing ──────────────────────────────────────────────────────────
set tabstop=4          " display tab as 4 spaces
set shiftwidth=4       " indent by 4 spaces
set expandtab          " use spaces instead of tabs
set smartindent        " auto-indent new lines
set backspace=indent,eol,start

" ── Appearance ───────────────────────────────────────────────────────
set number             " line numbers
set relativenumber     " relative line numbers
set cursorline         " highlight current line
set colorcolumn=80     " ruler at column 80
set scrolloff=8        " keep 8 lines above/below cursor
set laststatus=2       " always show status line
set showmatch          " highlight matching brackets
set wrap               " wrap long lines
syntax enable

" ── Search ───────────────────────────────────────────────────────────
set incsearch          " incremental search
set hlsearch           " highlight matches
set ignorecase         " case-insensitive search …
set smartcase          " … unless pattern has uppercase
nnoremap <Esc><Esc> :nohlsearch<CR>

" ── Files ────────────────────────────────────────────────────────────
set autoread           " reload file if changed outside vim
set noswapfile
set nobackup
set undofile
set undodir=/root/.vim/undo

" ── Splits & navigation ──────────────────────────────────────────────
set splitright
set splitbelow
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" ── Leader key ───────────────────────────────────────────────────────
let mapleader = " "

" ── Plugins (vim-plug) ───────────────────────────────────────────────
call plug#begin('~/.vim/plugged')
  Plug 'tpope/vim-commentary'          " gcc to comment line
  Plug 'tpope/vim-surround'            " cs, ds, ys motions
  Plug 'tpope/vim-fugitive'            " :Git commands
  Plug 'airblade/vim-gitgutter'        " git diff in gutter
  Plug 'vim-airline/vim-airline'       " status bar
  Plug 'vim-airline/vim-airline-themes'
  Plug 'morhetz/gruvbox'               " colour scheme
  Plug 'preservim/nerdtree'            " file tree
  Plug 'ctrlpvim/ctrlp.vim'           " fuzzy file finder
  Plug 'dense-analysis/ale'            " async lint / gcc errors inline
call plug#end()

" ── Colour scheme ────────────────────────────────────────────────────
set background=dark
colorscheme gruvbox

" ── NERDTree ─────────────────────────────────────────────────────────
nnoremap <leader>e :NERDTreeToggle<CR>
let NERDTreeShowHidden=1

" ── CtrlP ────────────────────────────────────────────────────────────
let g:ctrlp_working_path_mode = 'ra'

" ── ALE (linting) ────────────────────────────────────────────────────
let g:ale_linters = {'c': ['gcc']}
let g:ale_c_gcc_options = '-Wall -Wextra -std=c11'
let g:ale_sign_error   = '✗'
let g:ale_sign_warning = '⚠'
let g:ale_echo_msg_format = '[%linter%] %s'

" ── Airline ──────────────────────────────────────────────────────────
let g:airline_theme = 'gruvbox'
let g:airline_powerline_fonts = 0
let g:airline#extensions#ale#enabled = 1

" ── Undo directory ───────────────────────────────────────────────────
silent !mkdir -p /root/.vim/undo
