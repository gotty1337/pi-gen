[Unit]
Description=Configure CUPS PDF printer queue
After=cups.service
Requires=cups.service
# Only run once; sentinel file is created by ExecStartPost.
ConditionPathExists=!/etc/cups/.printer-configured

[Service]
Type=oneshot
ExecStart=/home/pi/usb-gadget/cups_printer_setup.sh
ExecStartPost=/bin/touch /etc/cups/.printer-configured
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
